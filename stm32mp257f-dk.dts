/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "STMicroelectronics STM32MP257F-DK Discovery Board";
	compatible = "st,stm32mp257f-dk\0st,stm32mp257";

	dbg-shm-uio@20062000 {
		status = "okay";
		reg = <0x00 0x20062000 0x00 0x2000>;
		memory-region = <0x19d>;
		compatible = "generic-uio";
	};

	ipcc1@40490000 {
		status = "okay";
		interrupts = <0x00 0xab 0x04>;
		interrupt-parent = <0x06>;
		clocks = <0x14 0x69>;
		reg = <0x00 0x40490000 0x00 0x400>;
		compatible = "generic-uio";
	};

	ipc-shm-uio@20064000 {
		status = "okay";
		reg = <0x00 0x20064000 0x00 0x4000>;
		memory-region = <0x19c>;
		compatible = "generic-uio";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a35";
			device_type = "cpu";
			reg = <0x00>;
			enable-method = "psci";
			power-domains = <0x01 0x02 0x00>;
			power-domain-names = "psci\0perf";
			#cooling-cells = <0x02>;
			phandle = <0x04>;
		};

		idle-states {
			entry-method = "psci";

			cpu-power-down {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01>;
				local-timer-stop;
				entry-latency-us = <0x96>;
				exit-latency-us = <0xc8>;
				min-residency-us = <0x3e8>;
				phandle = <0x08>;
			};
		};

		domain-idle-states {

			domain-stop1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x11>;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x1f4>;
				min-residency-us = <0x5dc>;
				phandle = <0x09>;
			};

			domain-lp-stop1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x21>;
				entry-latency-us = <0x15e>;
				exit-latency-us = <0x258>;
				min-residency-us = <0x7d0>;
				phandle = <0x0a>;
			};

			domain-lplv-stop1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x211>;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x7d0>;
				min-residency-us = <0x9c4>;
				phandle = <0x0c>;
			};
		};

		cpu@1 {
			compatible = "arm,cortex-a35";
			device_type = "cpu";
			reg = <0x01>;
			enable-method = "psci";
			power-domains = <0x03 0x02 0x00>;
			power-domain-names = "psci\0perf";
			phandle = <0x05>;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a35-pmu";
		interrupts = <0x00 0x170 0x04 0x00 0x171 0x04>;
		interrupt-affinity = <0x04 0x05>;
		interrupt-parent = <0x06>;
	};

	watchdog {
		compatible = "arm,smc-wdt";
		arm,smc-id = <0xbc000000>;
		status = "okay";
		timeout-sec = <0x20>;
		phandle = <0xb7>;
	};

	clocks {

		clk-rcbsec {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x3d09000>;
			phandle = <0x48>;
		};

		clk-ext-camera {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x16e3600>;
			phandle = <0x27>;
		};

		clk-ext-cec {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x16e3600>;
			phandle = <0x2b>;
		};
	};

	firmware {

		optee {
			bootph-all;
			compatible = "linaro,optee-tz";
			method = "smc";
			interrupt-parent = <0x06>;
			interrupts = <0x01 0x0f 0x308>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
			phandle = <0xad>;
		};

		scmi {
			bootph-all;
			compatible = "linaro,scmi-optee";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			linaro,optee-channel-id = <0x00>;
			phandle = <0xb8>;

			protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <0x01>;
				phandle = <0x7b>;
			};

			protocol@13 {
				reg = <0x13>;
				#power-domain-cells = <0x01>;
				phandle = <0x02>;
			};

			protocol@14 {
				bootph-all;
				reg = <0x14>;
				#clock-cells = <0x01>;
				phandle = <0x14>;
			};

			protocol@16 {
				reg = <0x16>;
				#reset-cells = <0x01>;
				phandle = <0x1b>;
			};

			protocol@17 {
				reg = <0x17>;
				phandle = <0xb9>;

				regulators {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0xba>;

					regulator@0 {
						reg = <0x00>;
						regulator-name = "vddio1";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x5b>;
					};

					regulator@1 {
						reg = <0x01>;
						regulator-name = "vddio2";
						phandle = <0x62>;
					};

					regulator@2 {
						reg = <0x02>;
						regulator-name = "vddio3";
						phandle = <0xbb>;
					};

					regulator@3 {
						reg = <0x03>;
						regulator-name = "vddio4";
						phandle = <0xbc>;
					};

					regulator@5 {
						reg = <0x05>;
						regulator-name = "vdd33ucpd";
						phandle = <0xbd>;
					};

					regulator@7 {
						reg = <0x07>;
						regulator-name = "vdda18adc";
						phandle = <0xbe>;
					};

					regulator@b {
						reg = <0x0b>;
						regulator-name = "vddcore";
						phandle = <0x52>;
					};

					regulator@e {
						reg = <0x0e>;
						regulator-name = "v1v8";
						phandle = <0x2c>;
					};

					regulator@10 {
						reg = <0x10>;
						regulator-name = "v3v3";
						phandle = <0x28>;
					};

					regulator@12 {
						reg = <0x12>;
						regulator-name = "vdd_emmc";
						phandle = <0x61>;
					};

					regulator@14 {
						reg = <0x14>;
						regulator-name = "vdd3v3_usb";
						phandle = <0x13>;
					};

					regulator@15 {
						reg = <0x15>;
						regulator-name = "v5v_hdmi";
						phandle = <0xaf>;
					};

					regulator@16 {
						reg = <0x16>;
						regulator-name = "v5v_vconn";
						phandle = <0xbf>;
					};

					regulator@17 {
						reg = <0x17>;
						regulator-name = "vdd_sdcard";
						phandle = <0x5a>;
					};
				};
			};
		};
	};

	interrupt-controller@4ac00000 {
		compatible = "st,stm32mp2-cortex-a7-gic\0arm,cortex-a7-gic";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		interrupt-parent = <0x06>;
		reg = <0x00 0x4ac10000 0x00 0x1000 0x00 0x4ac20000 0x00 0x2000 0x00 0x4ac40000 0x00 0x2000 0x00 0x4ac60000 0x00 0x2000>;
		interrupts = <0x01 0x09 0x308>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x06>;

		v2m@48090000 {
			compatible = "arm,gic-v2m-frame";
			reg = <0x00 0x48090000 0x00 0x1000>;
			msi-controller;
			phandle = <0x73>;
		};
	};

	power-domain-d1 {
		compatible = "st,stm32mp-pm-domain";
		#power-domain-cells = <0x00>;
		power-domains = <0x07>;
		phandle = <0x19>;
	};

	psci {
		bootph-all;
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x08>;
			power-domains = <0x07>;
			phandle = <0x01>;
		};

		power-domain-cluster {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x09 0x0a>;
			power-domains = <0x0b>;
			phandle = <0x07>;
		};

		power-domain-retention {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x0c>;
			phandle = <0x0b>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x08>;
			power-domains = <0x07>;
			phandle = <0x03>;
		};
	};

	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x0d 0x01>;

			trips {

				cpu-alert {
					temperature = <0x1adb0>;
					hysteresis = <0x2710>;
					type = "passive";
					phandle = <0x0e>;
				};

				cpu-crit {
					temperature = <0x1dc90>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				gpu-alert {
					temperature = <0x1adb0>;
					hysteresis = <0x2710>;
					type = "passive";
					phandle = <0x0f>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0e>;
					cooling-device = <0x04 0x01 0x01>;
				};

				map1 {
					trip = <0x0f>;
					cooling-device = <0x10 0x01 0x06>;
				};
			};
		};

		soc-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x0d 0x00>;

			trips {

				soc-crit {
					temperature = <0x1dc90>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x06>;
		interrupts = <0x01 0x0d 0x308 0x01 0x0e 0x308 0x01 0x0b 0x308 0x01 0x0a 0x308>;
		arm,no-tick-in-suspend;
	};

	usb2-phy1 {
		compatible = "st,stm32mp25-usb2phy";
		#phy-cells = <0x00>;
		#clock-cells = <0x01>;
		st,syscfg = <0x11 0x2400>;
		clocks = <0x12 0x140 0x12 0x176>;
		clock-names = "core\0stp";
		resets = <0x12 0x3f>;
		status = "okay";
		vdd33-supply = <0x13>;
		phandle = <0x6e>;
	};

	usb2-phy2 {
		compatible = "st,stm32mp25-usb2phy";
		#phy-cells = <0x00>;
		#clock-cells = <0x01>;
		st,syscfg = <0x11 0x2800>;
		clocks = <0x12 0x128>;
		clock-names = "core";
		resets = <0x12 0x40>;
		status = "okay";
		vdd33-supply = <0x13>;
		phandle = <0x70>;
	};

	soc@0 {
		bootph-all;
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		interrupt-parent = <0x06>;
		ranges = <0x00 0x00 0x00 0x80000000>;

		dma-controller@40400000 {
			compatible = "st,stm32-dma3";
			reg = <0x40400000 0x1000>;
			interrupts = <0x00 0x21 0x04 0x00 0x22 0x04 0x00 0x23 0x04 0x00 0x24 0x04 0x00 0x25 0x04 0x00 0x26 0x04 0x00 0x27 0x04 0x00 0x28 0x04 0x00 0x29 0x04 0x00 0x2a 0x04 0x00 0x2b 0x04 0x00 0x2c 0x04 0x00 0x2d 0x04 0x00 0x2e 0x04 0x00 0x2f 0x04 0x00 0x30 0x04>;
			clocks = <0x14 0x65>;
			power-domains = <0x0b>;
			#dma-cells = <0x03>;
			st,axi-max-burst-len = <0x10>;
			memory-region = <0x15>;
			phandle = <0x1a>;
		};

		dma-controller@40410000 {
			compatible = "st,stm32-dma3";
			reg = <0x40410000 0x1000>;
			interrupts = <0x00 0x31 0x04 0x00 0x32 0x04 0x00 0x33 0x04 0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x38 0x04 0x00 0x39 0x04 0x00 0x3a 0x04 0x00 0x3b 0x04 0x00 0x3c 0x04 0x00 0x3d 0x04 0x00 0x3e 0x04 0x00 0x3f 0x04 0x00 0x40 0x04>;
			clocks = <0x14 0x66>;
			power-domains = <0x0b>;
			#dma-cells = <0x03>;
			st,axi-max-burst-len = <0x10>;
			memory-region = <0x16>;
			phandle = <0xc0>;
		};

		dma-controller@40420000 {
			compatible = "st,stm32-dma3";
			reg = <0x40420000 0x1000>;
			interrupts = <0x00 0x41 0x04 0x00 0x42 0x04 0x00 0x43 0x04 0x00 0x44 0x04 0x00 0x45 0x04 0x00 0x46 0x04 0x00 0x47 0x04 0x00 0x48 0x04 0x00 0x49 0x04 0x00 0x4a 0x04 0x00 0x4b 0x04 0x00 0x4c 0x04 0x00 0x4d 0x04 0x00 0x4e 0x04 0x00 0x4f 0x04 0x00 0x50 0x04>;
			clocks = <0x14 0x67>;
			power-domains = <0x0b>;
			#dma-cells = <0x03>;
			st,axi-max-burst-len = <0x10>;
			memory-region = <0x17>;
			phandle = <0xc1>;
		};

		mailbox@40490000 {
			compatible = "st,stm32mp1-ipcc";
			#mbox-cells = <0x01>;
			reg = <0x40490000 0x400>;
			st,proc-id = <0x00>;
			interrupts = <0x00 0xab 0x04 0x00 0xac 0x04>;
			interrupt-names = "rx\0tx";
			clocks = <0x14 0x69>;
			status = "disabled";
			phandle = <0x9b>;
		};

		ommanager@40500000 {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			compatible = "st,stm32mp25-omm";
			reg = <0x40500000 0x400 0x60000000 0x10000000>;
			reg-names = "omm\0omm_mm";
			clocks = <0x12 0x6b>;
			resets = <0x12 0x5a>;
			st,syscfg-amcr = <0x11 0x2c00 0x07>;
			access-controllers = <0x18 0x6f>;
			power-domains = <0x19>;
			status = "disabled";
			ranges = <0x00 0x00 0x40430000 0x400 0x01 0x00 0x40440000 0x400>;
			phandle = <0xc2>;

			spi@40430000 {
				compatible = "st,stm32mp25-omi";
				reg = <0x00 0x00 0x400>;
				interrupts = <0x00 0xa3 0x04>;
				dmas = <0x1a 0x02 0x62 0x3121 0x1a 0x02 0x42 0x3112>;
				dma-names = "tx\0rx";
				st,syscfg-dlyb = <0x11 0x1000>;
				clocks = <0x14 0x74>;
				resets = <0x1b 0x05 0x1b 0x06>;
				access-controllers = <0x18 0x4a>;
				power-domains = <0x19>;
				status = "disabled";
				phandle = <0xc3>;
			};

			spi@40440000 {
				compatible = "st,stm32mp25-omi";
				reg = <0x01 0x00 0x400>;
				interrupts = <0x00 0xa4 0x04>;
				dmas = <0x1a 0x03 0x62 0x3121 0x1a 0x03 0x42 0x3112>;
				dma-names = "tx\0rx";
				st,syscfg-dlyb = <0x11 0x1400>;
				clocks = <0x14 0x75>;
				resets = <0x1b 0x07 0x1b 0x08>;
				access-controllers = <0x18 0x4b>;
				power-domains = <0x19>;
				status = "disabled";
				phandle = <0xc4>;
			};
		};

		bus@42080000 {
			bootph-all;
			compatible = "st,stm32mp25-rifsc\0simple-bus";
			reg = <0x42080000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			#access-controller-cells = <0x01>;
			ranges;
			st,mem-map = <0x200c0000 0x2000 0x200c2000 0x2000 0x200c4000 0x4000>;
			phandle = <0x18>;

			timer@40000000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40000000 0x400>;
				interrupts = <0x00 0x69 0x04>;
				interrupt-names = "global";
				clocks = <0x12 0xdb>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x18 0x01>;
				power-domains = <0x19>;
				status = "disabled";
				phandle = <0xc5>;

				pwm {
					compatible = "st,stm32mp25-pwm";
					#pwm-cells = <0x03>;
					status = "disabled";
				};

				timer@1 {
					compatible = "st,stm32mp25-timer-trigger";
					reg = <0x01>;
					status = "disabled";
				};

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};
			};

			timer@40010000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40010000 0x400>;
				interrupts = <0x00 0x6a 0x04>;
				interrupt-names = "global";
				clocks = <0x12 0xdc>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x18 0x02>;
				power-domains = <0x19>;
				status = "okay";
				phandle = <0xc6>;

				pwm {
					compatible = "st,stm32mp25-pwm";
					#pwm-cells = <0x03>;
					status = "okay";
					pinctrl-0 = <0x1c>;
					pinctrl-1 = <0x1d>;
					pinctrl-names = "default\0sleep";
					phandle = <0xb3>;
				};

				timer@2 {
					compatible = "st,stm32mp25-timer-trigger";
					reg = <0x02>;
					status = "disabled";
				};

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};
			};

			timer@40020000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40020000 0x400>;
				interrupts = <0x00 0x6b 0x04>;
				interrupt-names = "global";
				clocks = <0x12 0xdd>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x18 0x03>;
				power-domains = <0x19>;
				status = "okay";
				phandle = <0xc7>;

				pwm {
					compatible = "st,stm32mp25-pwm";
					pinctrl-names = "default", "sleep";
					pinctrl-0 = <&tim4_pwm_pins_mx>;
					pinctrl-1 = <&tim4_pwm_sleep_pins_mx>;
					status = "okay";
				};

				timer@3 {
					compatible = "st,stm32mp25-timer-trigger";
					reg = <0x03>;
					status = "disabled";
				};

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};
			};

			timer@40030000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40030000 0x400>;
				interrupts = <0x00 0x7c 0x04>;
				interrupt-names = "global";
				clocks = <0x12 0xde>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x18 0x04>;
				power-domains = <0x19>;
				status = "okay";
				phandle = <0xc8>;

				pwm {
					compatible = "st,stm32mp25-pwm";
					pinctrl-names = "default", "sleep";
					pinctrl-0 = <&tim5_pwm_pins_mx>;
					pinctrl-1 = <&tim5_pwm_sleep_pins_mx>;
					status = "okay";
				};

				timer@4 {
					compatible = "st,stm32mp25-timer-trigger";
					reg = <0x04>;
					status = "disabled";
				};

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};
			};

			timer@40040000 {
				compatible = "st,stm32mp25-timers";
				reg = <0x40040000 0x400>;
				interrupts = <0x00 0x80 0x04>;
				interrupt-names = "global";
				clocks = <0x12 0xdf>;
				clock-names = "int";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				access-controllers = <0x18 0x05>;
				power-domains = <0x19>;
				status = "disabled";
				phandle = <0xc9>;

				counter {
					compatible = "st,stm32mp25-timer-counter";
					status = "disabled";
				};

				timer@5 {
