		framebuffer {
			compatible = "simple-framebuffer";
			clocks = <0x12 0xce 0x12 0x153 0x12 0x152 0x12 0x125>;
			status = "disabled";
		};
	};

	clock_critical {
		compatible = "st,stm32-hog";
		clocks = <0x12 0x171>;
		phandle = <0x197>;
	};

	dmic-0 {
		compatible = "dmic-codec";
		#sound-dai-cells = <0x01>;
		sound-name-prefix = "dmic0";
		vref-supply = <0x28>;
		status = "okay";
		phandle = <0x198>;

		port {

			endpoint {
				remote-endpoint = <0xaa>;
				phandle = <0x44>;
			};
		};
	};

	dmic-1 {
		compatible = "dmic-codec";
		#sound-dai-cells = <0x01>;
		sound-name-prefix = "dmic1";
		vref-supply = <0x28>;
		status = "okay";
		phandle = <0x199>;

		port {

			endpoint {
				remote-endpoint = <0xab>;
				phandle = <0x46>;
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-user-1 {
			label = "User-1";
			linux,code = <0x101>;
			gpios = <0xac 0x05 0x00>;
			status = "okay";
		};

		button-user-2 {
			label = "User-2";
			linux,code = <0x102>;
			gpios = <0xac 0x0b 0x00>;
			status = "disabled";
		};

		button-wake-up {
			label = "wake-up";
			linux,code = <0x8f>;
			interrupts-extended = <0xad 0x00>;
			wakeup-source;
			status = "okay";
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		led-blue {
			function = "heartbeat";
			color = <0x03>;
			gpios = <0xae 0x07 0x00>;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};

	connector {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "a";
		hdmi-pwr-supply = <0xaf>;
		phandle = <0x19a>;

		port {

			endpoint {
				remote-endpoint = <0xb0>;
				phandle = <0x2e>;
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x01 0x00>;
	};

	panel-lvds {
		compatible = "edt,etml0700z9ndha\0panel-lvds";
		enable-gpios = <0x30 0x04 0x00>;
		backlight = <0xb1>;
		power-supply = <0x28>;
		status = "okay";
		width-mm = <0x9c>;
		height-mm = <0x5c>;
		data-mapping = "vesa-24";
		phandle = <0x19b>;

		panel-timing {
			clock-frequency = <0x337f980>;
			hactive = <0x400>;
			vactive = <0x258>;
			hfront-porch = <0x96>;
			hback-porch = <0x96>;
			hsync-len = <0x15>;
			vfront-porch = <0x18>;
			vback-porch = <0x18>;
			vsync-len = <0x15>;
		};

		port {

			endpoint {
				remote-endpoint = <0xb2>;
				phandle = <0x7a>;
			};
		};
	};

	panel-lvds-backlight {
		compatible = "pwm-backlight";
		pwms = <0xb3 0x01 0xf4240 0x00>;
		brightness-levels = <0x00 0x10 0x16 0x1e 0x28 0x37 0x4b 0x66 0x8a 0xbc 0xff>;
		default-brightness-level = <0x0a>;
		power-supply = <0x28>;
		status = "okay";
		phandle = <0xb1>;
	};

	sound {
		compatible = "audio-graph-card";
		label = "STM32MP25-DK";
		dais = <0xb4 0xb5 0xb6>;
		status = "okay";
	};

	wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x37 0x08 0x01>;
		clocks = <0x38>;
		clock-names = "ext_clock";
		phandle = <0x66>;
	};

